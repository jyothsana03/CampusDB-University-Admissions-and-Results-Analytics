digraph ER {
bgcolor="white"; pad=0.1; splines=line;
node [shape=plaintext, fontname="DejaVu Sans"]; edge [color="#52514e", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.2];
department [pos="0,2.7!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>department</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">dept_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">dept_name</FONT></TD></TR></TABLE>>];
programme [pos="3.0,2.7!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>programme</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">programme_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">programme_code</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">programme_name</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">dept_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">level, seats</FONT></TD></TR></TABLE>>];
course [pos="6.0,2.7!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>course</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">course_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">course_code, title</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">credits, semester</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">programme_id</FONT></TD></TR></TABLE>>];
student [pos="3.0,0!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>student</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">student_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">reg_no, full_name</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">programme_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">admission_year</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">entrance_score</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">cgpa (trigger)</FONT></TD></TR></TABLE>>];
enrolment [pos="6.0,0!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>enrolment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">enrolment_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">student_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">course_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">academic_year</FONT></TD></TR></TABLE>>];
exam [pos="9.0,2.7!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>exam</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">exam_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">course_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">academic_year</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">exam_date, max_marks</FONT></TD></TR></TABLE>>];
result [pos="9.0,0!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9bb7de" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#0b5cad"><FONT COLOR="white" POINT-SIZE="14"><B>result</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#b3261e" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">result_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">enrolment_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">exam_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#6250d6" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">marks_obtained</FONT></TD></TR></TABLE>>];
department -> programme;
programme -> course;
programme -> student;
student -> enrolment;
course -> enrolment;
course -> exam;
enrolment -> result;
exam -> result;
}